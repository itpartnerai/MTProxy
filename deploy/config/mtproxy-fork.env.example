MTPROXY_FORK_USER=nobody
MTPROXY_FORK_BIN=/usr/local/libexec/mtproxy-fork/mtproto-proxy
MTPROXY_FORK_WORKDIR=/var/lib/mtproxy-fork

MTPROXY_FORK_PUBLIC_PORT=5443
MTPROXY_FORK_STATS_PORT=8888
MTPROXY_FORK_WORKERS=2

MTPROXY_FORK_CLIENT_SECRET_FILE=/etc/mtproxy-fork/user-secret
MTPROXY_FORK_PROXY_SECRET_FILE=/etc/mtproxy-fork/proxy-secret
MTPROXY_FORK_PROXY_CONFIG_FILE=/etc/mtproxy-fork/proxy-multi.conf

MTPROXY_FORK_ADMIN_TOKEN=replace-with-long-random-token
MTPROXY_FORK_ADMIN_PORT=7081
MTPROXY_FORK_ADMIN_STATE_FILE=/var/lib/mtproxy-fork/admin-secrets.json

# Optional
# MTPROXY_FORK_PROXY_TAG_FILE=/etc/mtproxy-fork/proxy-tag
# MTPROXY_FORK_EXTRA_ARGS=--http-stats
